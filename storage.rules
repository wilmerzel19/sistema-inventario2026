rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /stores/{storeId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == storeId
                   && request.resource.size < 6 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
